# LangSmith: traces, datasets, and experiments
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=fernbrook-support-chatbot
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # change for EU or self-hosted

# Anthropic: the chatbot and the LLM judges
ANTHROPIC_API_KEY=sk-ant-...

# Experiment variable: the two models under test
MODEL_X=claude-haiku-5-5     # fast / cheap
MODEL_Y=claude-sonnet-5-5    # stronger

# Held constant across all 4 configs (current Claude models don't accept temperature)
CHAT_EFFORT=low

# LLM-as-judge for correctness, conciseness, no_hallucination, preferred_by_customer
JUDGE_MODEL=claude-opus-5-5
JUDGE_EFFORT=medium
